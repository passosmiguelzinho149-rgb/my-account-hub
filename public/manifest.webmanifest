{
  "name": "Bradesco Empresas e Negócios — Demonstração",
  "short_name": "Bradesco Empresas Demo",
  "description": "Aplicativo de demonstração visual, sem operações bancárias reais.",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#ffffff",
  "theme_color": "#2f2b9f",
  "orientation": "portrait-primary",
  "categories": ["finance", "business"],
  "lang": "pt-BR",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
